{
	"javascript": {
		"formatter": {
			"indentStyle": "tab",
			"indentWidth": 2,
			"lineWidth": 250,
			"expand": "never",
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"bracketSpacing": false,
			"delimiterSpacing": false,
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"semicolons": "asNeeded",
			"trailingCommas": "none"
		}
	}
}
